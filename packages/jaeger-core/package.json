{
    "name": "@jaeger/core",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./auth": {
            "types": "./dist/auth/index.d.ts",
            "import": "./dist/auth/index.js"
        },
        "./errors": {
            "types": "./dist/errors/index.d.ts",
            "import": "./dist/errors/index.js"
        }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc --build tsconfig.json",
        "typecheck": "tsc --build tsconfig.json --dry",
        "clean": "tsc --build tsconfig.json --clean && rm -rf dist",
        "dev": "tsc --build tsconfig.json --watch"
    },
    "dependencies": {
        "@jaeger/shared-contracts": "workspace:*",
        "uuid": "^14.0.0"
    }
}
